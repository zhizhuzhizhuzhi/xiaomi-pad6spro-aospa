android_app {
    name: "MiLahainaVision",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "setup-wizard-lib",
        "setupcompat",
        "setupdesign",
        "vendor.milahaina.biometrics.face-V2-java",
    ],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    system_ext_specific: true,
    required: ["privapp_whitelist_org.milahaina.vision.xml"],
}
