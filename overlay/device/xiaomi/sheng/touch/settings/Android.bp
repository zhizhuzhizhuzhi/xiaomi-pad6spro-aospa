// SPDX-License-Identifier: Apache-2.0
cc_library_shared {
    name: "libshengtouchtoggle",
    srcs: ["touchtoggle.c"],
    header_libs: ["jni_headers"],
    stl: "none",
    system_ext_specific: true,
    compile_multilib: "64",
}
android_app {
    name: "ShengTouchControl",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    jni_libs: ["libshengtouchtoggle"],
    use_embedded_native_libs: true,
    compile_multilib: "64",
}
