old mode 100755
new mode 100644
index b6b1b6e..764150b
--- a/displayfeature/apply-compat-libraries.py
+++ b/displayfeature/apply-compat-libraries.py
@@ -1,19 +1,14 @@
-#!/usr/bin/env python3
-# SPDX-License-Identifier: Apache-2.0
-"""Copy verified ABI-compatible device inputs to generated vendor trees."""
 from pathlib import Path
-import hashlib,json,shutil
+import json,hashlib,shutil
 base=Path(__file__).resolve().parent
 root=base.parents[3]
-for rel,item in json.loads((base/'compat-provenance.json').read_text())['vendor_targets'].items():
-    target=(root/rel).resolve()
-    if not target.is_relative_to(root/'vendor/xiaomi'):
-        raise ValueError('Unexpected vendor destination')
-    current=hashlib.sha256(target.read_bytes()).hexdigest()
-    if current not in (item['original_sha256'],item['fixed_sha256']):
-        raise ValueError('Unexpected vendor input: '+rel)
-    source=base.parent/item['device_source']
-    if hashlib.sha256(source.read_bytes()).hexdigest()!=item['fixed_sha256']:
-        raise ValueError('Run tools/extract-device-inputs.py first')
-    if current!=item['fixed_sha256']:
-        shutil.copyfile(source,target)
+assert (root/'device/xiaomi/sheng/displayfeature').resolve()==base
+meta=json.loads((base/'compat-provenance.json').read_text())
+for rel,item in meta['vendor_targets'].items():
+ target=root/rel
+ assert target.is_relative_to(root/'vendor/xiaomi')
+ before=hashlib.sha256(target.read_bytes()).hexdigest()
+ assert before in [item['original_sha256'],item['fixed_sha256']],(rel,before)
+ source=base.parent/item['device_source']
+ assert hashlib.sha256(source.read_bytes()).hexdigest()==item['fixed_sha256']
+ if before!=item['fixed_sha256']:shutil.copyfile(source,target)
